# Copy this file to .env and fill in the values.

PORT=3000

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Service role key: keep it secret, server-side only. Never put it in Flutter.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of website origins allowed to call the API.
# Leave empty during local development to allow all origins.
ALLOWED_ORIGINS=http://localhost:5000,https://www.vkncharities.org

# Optional: path to the Flutter web build so this server also hosts the site.
# e.g. ../frontend/build/web
FLUTTER_BUILD_DIR=../frontend/build/web
